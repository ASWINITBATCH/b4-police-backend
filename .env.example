# ── B4 Police Station Backend — Environment Config ──────────────────
# Copy this file to .env and fill in your values

# PostgreSQL connection string from Render.com
# Format: postgresql://username:password@host:5432/dbname
DATABASE_URL=postgresql://username:password@host:5432/dbname

# JWT Secret — use a long random string (min 32 chars)
# Generate one at: https://randomkeygen.com
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING_MIN_32_CHARS

# Port
PORT=3001

# Your Netlify frontend URL (for CORS)
FRONTEND_URL=https://b4-police-station.netlify.app

# Station details
STATION_NAME=B4 Police Station
STATION_CODE=B4

# Environment
NODE_ENV=production
